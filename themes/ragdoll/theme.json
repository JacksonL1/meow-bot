{
  "schemaVersion": 1,
  "name": "布偶猫 (60fps 骨骼弹簧物理版)",
  "author": "clawd-starter",
  "version": "2.0.0",
  "description": "支持二阶弹簧阻尼姿态插值、多段柔性尾巴、呼吸起伏、视线头部视差跟随、自然眨眼与耳廓微动的全身骨骼化布偶猫主题。",
  "rigType": "ragdoll-spring-v2",
  "states": {
    "idle": {
      "fps": 60,
      "eyeTracking": true,
      "frames": [
        "idle-1.svg",
        "idle-2.svg",
        "idle-3.svg"
      ]
    },
    "thinking": {
      "fps": 60,
      "eyeTracking": true,
      "frames": [
        "thinking-1.svg",
        "thinking-2.svg",
        "thinking-3.svg"
      ]
    },
    "working": {
      "fps": 60,
      "eyeTracking": false,
      "frames": [
        "working-1.svg",
        "working-2.svg",
        "working-3.svg",
        "working-4.svg"
      ]
    },
    "attention": {
      "fps": 60,
      "eyeTracking": true,
      "frames": [
        "attention-1.svg",
        "attention-2.svg"
      ]
    },
    "error": {
      "fps": 60,
      "eyeTracking": false,
      "frames": [
        "error-1.svg",
        "error-2.svg"
      ]
    },
    "notification": {
      "fps": 60,
      "eyeTracking": true,
      "frames": [
        "notification-1.svg",
        "notification-2.svg",
        "notification-3.svg",
        "notification-4.svg"
      ]
    },
    "sleeping": {
      "fps": 60,
      "eyeTracking": false,
      "frames": [
        "sleeping-1.svg",
        "sleeping-2.svg",
        "sleeping-3.svg"
      ]
    }
  },
  "timings": {
    "oneshot": {
      "error": 1200,
      "notification": 1500,
      "attention": 800
    },
    "sleepAfterMs": 20000
  }
}
